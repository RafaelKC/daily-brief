# Token de longa duração gerado com `claude setup-token` (usa sua assinatura, não a API)
CLAUDE_CODE_OAUTH_TOKEN=

# Token que o n8n manda no header Authorization: Bearer <...>
WORKER_TOKEN=

# Segredo que vai no caminho do feed: https://brief.example.com/<FEED_TOKEN>/feed.xml
FEED_TOKEN=

PUBLIC_BASE_URL=https://brief.example.com
CLAUDE_MODEL=sonnet
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=+8%
KEEP_EPISODES=10

# Personalização do prompt genérico (prompt.example.md). Crie um prompt.md para um prompt 100% seu.
BRIEF_OWNER=Fulano
BRIEF_CITY=São Paulo

# Rede Docker onde o n8n roda (veja com: docker network ls)
N8N_NETWORK=n8n_default

# Voz principal: Gemini TTS (chave grátis em aistudio.google.com/apikey). Vazio = usa edge-tts.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Charon

# Texto no canto das capas (ex.: seu domínio). Vazio = sem marca.
ARTWORK_BRAND=
